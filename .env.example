# OpenAI API Key (用于 Whisper 语音转文字)
OPENAI_API_KEY=sk-your-openai-api-key

# LLM API Key (如果与 OpenAI 不同，可配置此项，支持 GPT-4o, Gemini 等)
LLM_API_KEY=sk-your-llm-api-key
LLM_MODEL=gpt-4o

# stock-scoring 工作台推送（李大霄视角卡，2026-10-25）
# LLM 输出解读的时刻实时回调对方后端；不配置则静默关闭
# SCORING_PUSH_URL=https://your-render-app.onrender.com/api/market/lidaxiao/push
# SCORING_PUSH_TOKEN=与对方 Render env LIDX_PUSH_TOKEN 同一个值
